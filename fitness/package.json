{
  "name": "@shinobi/plugin-fitness",
  "version": "0.2.0",
  "description": "Reference Shinobi plugin — long-term adaptive fitness mission state (fitness_180) over the writable per-plugin state store. Structured facts only; the LLM owns the language.",
