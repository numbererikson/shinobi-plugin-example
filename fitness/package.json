    "mcp",
    "claude-code",
    "ai-agents",
    "fitness"
  ],
  "author": "Tomislav Krizan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/numbererikson/shinobi-plugin-example.git",
