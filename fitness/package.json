{
  "name": "shinobi-plugin-fitness",
  "version": "2.1.0",
  "description": "The System — a bodyweight strength plugin for Shinobi: progression ladders, daily quests, ranks E→S, animated exercise figures, injury-aware substitutions. Power tower optional.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "tsc && node scripts/bundle.mjs",
    "preview": "tsc && node scripts/preview.mjs",
    "test": "vitest run",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "shinobi",
    "shinobi-plugin",
    "mcp",
    "claude-code",
    "fitness",
    "calisthenics"
  ],
  "author": "Tomislav Krizan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/numbererikson/shinobi-plugin-example.git",
    "directory": "fitness"
  },
  "homepage": "https://github.com/numbererikson/shinobi-plugin-example/tree/main/fitness#readme",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
